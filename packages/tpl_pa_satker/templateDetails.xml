<?xml version="1.0" encoding="utf-8"?>
<extension type="template" client="site" method="upgrade">
    <name>pa_satker</name>
    <version>1.0.0</version>
    <creationDate>2026-11</creationDate>
    <author>Ditjen Badan Peradilan Agama</author>
    <authorEmail>badilag@mahkamahagung.go.id</authorEmail>
    <authorUrl>https://badilag.mahkamahagung.go.id</authorUrl>
    <copyright>(C) 2026 Mahkamah Agung RI</copyright>
    <license>GNU General Public License version 2 or later</license>
    <description>Template website satker Peradilan Agama sesuai SK Dirjen Badilag 2722/DJA/SK.TI1/X/2026. Warna primer #056e4f, sekunder #ff9900. Panel aksesibilitas, tanpa CDN.</description>

    <files>
        <folder>css</folder>
        <folder>js</folder>
        <folder>fonts</folder>
        <folder>html</folder>
        <filename>index.php</filename>
        <filename>component.php</filename>
        <filename>error.php</filename>
        <filename>offline.php</filename>
        <filename>joomla.asset.json</filename>
        <filename>template_thumbnail.png</filename>
    </files>

    <positions>
        <position>topbar</position>
        <position>mainnav</position>
        <position>home-top</position>
        <position>home-quick</position>
        <position>home-announce</position>
        <position>home-shortcut</position>
        <position>home-center</position>
        <position>home-side</position>
        <position>home-strip</position>
        <position>home-agenda</position>
        <position>home-video</position>
        <position>home-galeri</position>
        <position>home-welcome</position>
        <position>content-top</position>
        <position>breadcrumbs</position>
        <position>sidebar</position>
        <position>bottom</position>
        <position>footer-1</position>
        <position>footer-2</position>
        <position>footer-3</position>
        <position>footer-4</position>
        <position>footer-nav</position>
        <position>footer</position>
        <position>statistik-kunjungan</position>
        <position>debug</position>
    </positions>

    <config>
        <fields name="params">
            <fieldset name="advanced">
                <field name="brand_line" type="text" label="Baris instansi header" default="Mahkamah Agung Republik Indonesia" />
                <field name="logo_ma" type="media" label="Logo Mahkamah Agung" default="images/logo/logo-ma.png" />
                <field name="logo_satker" type="media" label="Logo satker" default="images/logo/logo-satker-placeholder.png" />
                <field name="sk_line" type="text" label="Baris dasar hukum footer" default="Standar Tata Kelola Website: SK Dirjen Badilag No. 2722/DJA/SK.TI1/X/2026 tanggal 12 Oktober 2026." />
                <field name="show_skiplink" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="Tautan lewati navigasi">
                    <option value="0">JHide</option>
                    <option value="1">JShow</option>
                </field>
                <field name="jam_layanan" type="text" label="Jam layanan bilah atas" default="Senin–Kamis 08.00–16.30 · Jumat 07.30–16.00 WIB" />
            </fieldset>
        </fields>
    </config>
</extension>
